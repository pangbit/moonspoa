// Root package of the module: a convenience facade that re-exports the
// SPOP protocol core (`pangbit/moonspoa/spop`) and the agent session logic
// (`pangbit/moonspoa/agent`) for users who want everything from one import.
//
// Deliberately NOT re-exported:
// - `pangbit/moonspoa/server` (TCP/UDS transport): native-only with heavier
//   dependencies; import it explicitly where needed.
// - `pangbit/moonspoa/client` (SPOE client / test peer): import it explicitly.

import {
  "pangbit/moonspoa/spop",
  "pangbit/moonspoa/agent",
}
